{
  "name": "MakerConnect RAG Pipeline v3.1",
  "nodes": [
    {
      "parameters": {
        "path": "extraction",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook_trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extrair dados do webhook\nconst triggerItem = $input.first().json;\nconst payload = triggerItem.body ?? triggerItem;\nconst { webhookId, projectId, projectTitle, input, keywords, piiRedactions, embeddingId, callbackUrl } = payload;\n\nreturn [{\n  json: {\n    webhookId,\n    projectId,\n    projectTitle,\n    embeddingId,\n    callbackUrl,\n    input: typeof input === 'string' ? input : '',\n    keywords: Array.isArray(keywords) ? keywords : [],\n    piiRedactions: piiRedactions || 0,\n    startedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "process_input",
      "name": "Process Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "resource": "embedding",
        "model": "text-embedding-3-small",
        "text": "={{ $json.keywords.join(', ') }}"
      },
      "id": "generate_embeddings",
      "name": "OpenAI Embeddings",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        560,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "operation": "search",
        "index": "maker-knowledge",
        "vector": "={{ $node[\"OpenAI Embeddings\"].json.embedding }}",
        "topK": 3
      },
      "id": "pinecone_search",
      "name": "Pinecone Search",
      "type": "n8n-nodes-base.pinecone",
      "typeVersion": 1,
      "position": [
        740,
        300
      ],
      "credentials": {
        "pineconeApi": {
          "id": "YOUR_PINECONE_CREDENTIAL_ID",
          "name": "Pinecone account"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "promptText": "=Gere requisitos técnicos e BOM para o projeto: {{ $node[\"Process Input\"].json.projectTitle }}.\n\nContexto do Usuário: {{ $node[\"Process Input\"].json.input }}\n\nEvidências Técnicas (Grounding):\n{{ $node[\"Pinecone Search\"].json.map(d => d.metadata.text).join('\\n') }}\n\nFormato de saída: JSON com keys: technicalRequirements (array), suggestedBOM (array), confidenceScore (number).",
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "generate_rag_content",
      "name": "OpenAI RAG",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        920,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Preparar payload final para o callback\nconst inputData = $node[\"Process Input\"].json;\nconst aiResponse = $node[\"OpenAI RAG\"].json;\nconst vectorResults = $node[\"Pinecone Search\"].json;\n\nconst totalLatencyMs = Date.now() - new Date(inputData.startedAt).getTime();\n\nconst outputContent = typeof aiResponse.message?.content === 'string' \n  ? JSON.parse(aiResponse.message.content) \n  : aiResponse;\n\nreturn [{\n  json: {\n    callbackUrl: inputData.callbackUrl,\n    payload: {\n      webhookId: inputData.webhookId,\n      status: \"done\",\n      n8nExecutionId: $execution.id,\n      latencyMs: totalLatencyMs,\n      output: {\n        ...outputContent,\n        groundingCount: vectorResults.length,\n        embeddingId: inputData.embeddingId\n      }\n    }\n  }\n}];"
      },
      "id": "prep_callback",
      "name": "Prep Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "id": "callback_api",
      "name": "Callback to API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1280,
        300
      ]
    }
  ],
  "connections": {
    "webhook_trigger": {
      "main": [
        [
          {
            "node": "process_input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "process_input": {
      "main": [
        [
          {
            "node": "generate_embeddings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "generate_embeddings": {
      "main": [
        [
          {
            "node": "pinecone_search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "pinecone_search": {
      "main": [
        [
          {
            "node": "generate_rag_content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "generate_rag_content": {
      "main": [
        [
          {
            "node": "prep_callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "prep_callback": {
      "main": [
        [
          {
            "node": "callback_api",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
