# API Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=makerconnect
DB_USER=maker
DB_PASSWORD=maker_password_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_dev

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_REFRESH_EXPIRY=7d

# S3 / Minio (Assets Upload)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=makerconnect
S3_REGION=us-east-1

# n8n (MakerBrain Orchestrator)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key

# Pinecone (Vector DB for RAG)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=makerconnect-rag
PINECONE_ENVIRONMENT=your_pinecone_environment

# External APIs
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_FORMAT=json
LOG_FILE=logs/app.log

# Features
ENABLE_RAG_SUGGESTIONS=true
ENABLE_AI_EXPORT=true
MAX_PDF_PROCESSING_TIMEOUT=120
