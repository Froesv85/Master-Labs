DATABASE_URL="mysql://root:root@localhost:3307/maker"

# Auth
JWT_SECRET=""

# OAuth — Google (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth — GitHub (github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Pinecone Vector DB
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX="maker-knowledge"

# Google Gemini
GEMINI_API_KEY=""
N8N_EXTRACTION_WEBHOOK_URL="http://localhost:5678/webhook/extraction"
API_URL="http://localhost:3000"

# Pipeline de extracao: motor n8n (webhook) ou bullmq (fila local) — os dois convivem
# pra comparar antes do corte definitivo. Default "n8n" preserva o comportamento atual.
EXTRACTION_ENGINE="n8n"
OLLAMA_GENERATE_MODEL="qwen2.5:7b-instruct"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"
PDF_EXPORT_INLINE_WORKER="true"
PDF_EXPORT_WORKER_CONCURRENCY="1"
EXTRACTION_INLINE_WORKER="true"
EXTRACTION_WORKER_CONCURRENCY="1"

# ML-72 benchmark gates
ML72_GATE_MAX_P95_MS="40000"

# Azure Cost Management (App Registration com papel "Cost Management Reader" na subscription)
# Sem essas variáveis, o card de consumo Azure em /admin/metrics mostra "não configurado".
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SUBSCRIPTION_ID=""

# Admin: após o primeiro login do usuário, promova-o com:
#   npm run promote-admin -- seu-email@exemplo.com

