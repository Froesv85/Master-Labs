# Copie para .env.local e preencha. Valores abaixo funcionam com o docker-compose.yml local
# (MySQL na porta 3307, Redis 6379, MinIO 9000, ml-pipeline 8001).

DATABASE_URL="mysql://root:root@localhost:3307/maker"

# Auth — gere um valor forte: openssl rand -base64 48
JWT_SECRET=""

# OAuth — Google (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth — GitHub (github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# URL publica do app: base dos callbacks OAuth/n8n e dos links nos PDFs
API_URL="http://localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"

# Pinecone Vector DB (busca vetorial e base tecnica do RAG)
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX="maker-knowledge"

# Ollama (embeddings + geracao). Em producao, apontar para o host onde o Ollama roda.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBED_MODEL="nomic-embed-text"
OLLAMA_GENERATE_MODEL="qwen2.5:7b-instruct"
# OLLAMA_NUM_PREDICT=""   # opcional: limite de tokens gerados

# Pipeline de extracao: "bullmq" (fila local, padrao em producao) ou "n8n" (legado).
# Sem a variavel, o codigo cai em "n8n".
EXTRACTION_ENGINE="bullmq"
N8N_EXTRACTION_WEBHOOK_URL="http://localhost:5678/webhook/extraction"   # so com EXTRACTION_ENGINE=n8n

# Redis — filas BullMQ (extracao e PDF) e rate limiting (lib/rate-limit.ts)
REDIS_URL="redis://localhost:6379"
PDF_EXPORT_INLINE_WORKER="true"
PDF_EXPORT_WORKER_CONCURRENCY="1"
EXTRACTION_INLINE_WORKER="true"
EXTRACTION_WORKER_CONCURRENCY="1"

# Armazenamento S3-compativel (MinIO local / em producao). Ver lib/s3-service.ts.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="maker-assets"
S3_ENDPOINT="http://localhost:9000"          # base das URLs publicas
# S3_INTERNAL_ENDPOINT=""                    # endpoint que o SDK usa (producao: http://minio:9000)
# S3_PUBLIC_URL_BASE=""                      # so para provedores com dominio publico separado (ex.: R2)

# Fase 5 - pipeline de estruturacao (ml-pipeline/, microsservico Python)
ML_PIPELINE_URL="http://localhost:8001"
ML_PIPELINE_ENABLED="true"

# ML-72 benchmark gates (scripts/)
ML72_GATE_MAX_P95_MS="40000"

# Admin: após o primeiro login do usuário, promova-o com:
#   npm run promote-admin -- seu-email@exemplo.com
