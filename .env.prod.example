# Copiar para .env.prod no VPS e preencher os valores.
# docker-compose.prod.yml também usa ${MYSQL_ROOT_PASSWORD}, ${AWS_ACCESS_KEY_ID}
# e ${AWS_SECRET_ACCESS_KEY} para substituição de variáveis no próprio compose —
# isso só funciona se esses valores também estiverem num arquivo `.env` (sem
# sufixo) no mesmo diretório. O mais simples é criar um symlink depois de
# preencher este arquivo: `ln -s .env.prod .env`.

# MySQL — container local (maker-mysql) ou banco Hostinger gerenciado
MYSQL_ROOT_PASSWORD="troque_por_senha_forte"
DATABASE_URL="mysql://root:troque_por_senha_forte@maker-mysql:3306/maker"

# Redis (container local)
REDIS_URL="redis://maker-redis:6379"

# Sessão / login (lib/auth.ts) — gere um valor novo e forte, NÃO reaproveite
# o JWT_SECRET usado em desenvolvimento.
# Ex.: openssl rand -base64 48
JWT_SECRET="troque_por_um_segredo_forte_e_unico"

# API pública (domínio do VPS)
API_URL="https://makerconnect.com.br"

# Armazenamento de arquivos — MinIO rodando no próprio VPS (container maker-minio),
# exposto publicamente via Nginx em /storage (ver nginx/maker-connect.conf).
# S3_ENDPOINT monta a URL pública das imagens/PDFs (por isso é o domínio
# público). S3_INTERNAL_ENDPOINT é o que o SDK realmente usa para falar com o
# MinIO — tem que ser o hostname interno "minio", não o domínio público: o
# Nginx remove o prefixo /storage/ ao repassar pro MinIO, o que quebra a
# assinatura SigV4 das chamadas do SDK se elas forem feitas contra o domínio
# público (403 SignatureDoesNotMatch).
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="troque_por_um_usuario_forte"
AWS_SECRET_ACCESS_KEY="troque_por_uma_senha_forte"
S3_ENDPOINT="https://makerconnect.com.br/storage"
S3_INTERNAL_ENDPOINT="http://minio:9000"
S3_BUCKET_NAME="maker-assets"

# PDF workers
PDF_EXPORT_INLINE_WORKER="true"
PDF_EXPORT_WORKER_CONCURRENCY="2"

# --- Opcional / fase 2 (RAG: busca semântica e extração de projetos) ---
# GEMINI_API_KEY não é lido em nenhum lugar do código hoje — não precisa setar.
# PINECONE_*, OLLAMA_* e N8N_EXTRACTION_WEBHOOK_URL só são usados pelo endpoint
# isolado /api/projects/search e pelo pipeline de extração — deixados vazios
# até o n8n + Ollama serem hospedados (fora do escopo do primeiro deploy).
PINECONE_API_KEY=""
PINECONE_INDEX="maker-knowledge"
OLLAMA_BASE_URL=""
OLLAMA_EMBED_MODEL="nomic-embed-text"
N8N_EXTRACTION_WEBHOOK_URL=""
